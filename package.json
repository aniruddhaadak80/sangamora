{
  "name": "sangamora",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "assets": "node scripts/gen-assets.mjs",
    "verify": "node scripts/gen-assets.mjs --verify",
    "generate": "bun scripts/generate.ts --all",
    "generate:check": "bun scripts/generate.ts --verify",
    "loc": "bun scripts/loc-count.mjs",
    "loc:min": "bun scripts/loc-count.mjs --min-lines 1000000"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "next": "16.4.3",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
