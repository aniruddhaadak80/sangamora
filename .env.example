# ─────────────────────────────────────────────────────────────────────────────
# sangamora — zero API keys required. The simulation is deterministic and
# fully offline by default; every variable below is optional.
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin, used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deterministic world seed (any integer). Same seed in, same universe out.
MELA_SEED=7331

# Optional SSE relay daemon (services/relay, Go) — broadcasts live ticks.
RELAY_PORT=7331

# Optional crowd-marshal agent service (services/agents, Python FastAPI).
AGENTS_PORT=7332

# Deploy credentials are NEVER committed — resolve from your own environment:
# VERCEL_TOKEN={env:VERCEL_TOKEN}
